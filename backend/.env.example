# Every setting the backend reads, as environment variables. Locally `export`
# the ones you need; in production they live in Render (API) and GitHub
# Secrets (scanner).
# Defaults run the whole product locally with no external account.

# dev | e2e | prod | worker. prod refuses the shortcuts below (dev login, fake billing).
APP_ENV=dev

# --- Databases --------------------------------------------------------------
# Service-management database: users, plans, user→database registry, Telegram links.
# Local: sqlite:///./data/control.db   Production: libsql://<db>-<org>.turso.io
CONTROL_DB_URL=sqlite:///./data/control.db
CONTROL_DB_TOKEN=

# Each user's own database. sqlite = one file per user (local);
# turso = one hosted Turso database per user, created via the Platform API.
TENANT_PROVISIONER=sqlite
TENANT_SQLITE_DIR=./data/tenants
TURSO_API_TOKEN=          # turso auth api-tokens mint metravo
TURSO_ORG=                # your Turso organisation slug
TURSO_GROUP=default

# --- Sign-in ----------------------------------------------------------------
JWT_SECRET=dev-only-secret-change-me     # any long random string in production
JWT_TTL_HOURS=336
AUTH_PROVIDERS=dev                       # production: firebase
FIREBASE_PROJECT_ID=
FIREBASE_WEB_CONFIG=                     # the JSON from Firebase console → Project settings → Web app
ADMIN_EMAILS=                            # comma-separated; these accounts see /admin

# --- URLs -------------------------------------------------------------------
FRONTEND_URL=http://localhost:4200
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:4200

# --- Telegram ---------------------------------------------------------------
# Without a token, messages are logged instead of sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=metravo_bot
TELEGRAM_WEBHOOK_SECRET=dev-webhook-secret

# --- Payments ---------------------------------------------------------------
BILLING_PROVIDER=fake                    # production: stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=                        # price id of the monthly Pro price

# --- Scanning ---------------------------------------------------------------
PAGE_FETCHER=http                        # fixtures = read saved pages from FIXTURES_DIR
FIXTURES_DIR=./tests/fixtures/pages
SCAN_PAGES=1
SCAN_DELAY_SECONDS=2
CRON_SECRET=                             # shared secret for POST /api/scan/cron
